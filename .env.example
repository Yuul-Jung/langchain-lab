# This file has no real credentials.
# 실제 값은 같은 폴더의 .env 에 둡니다 (.env 는 GitHub에 올라가지 않음).
# 비어 있거나 없는 항목은 settings.py 의 기본값을 씁니다.

# ---- Elasticsearch
ES_URL=https://localhost:9200
ES_USER=elastic
ES_CA_CERT=~/.config/elasticsearch/http_ca.crt
ES_PASSWORD=CHANGE_ME
ES_RAG_INDEX=langchain_embedding_lab
ES_DOCUMENT_INDEX=langchain_documents_v1
# 채팅 RAG 모드가 검색할 곳: documents(업로드 문서) · lab(제1장 실습 문장 3개) · both
CHAT_RAG_SOURCE=documents
# 검색 결과 컷오프: 1위 점수에서 이 폭 안에 든 결과만 보여 줍니다 (점수 0~1, 0 이면 끔).
# 넓히면 결과가 많아지고, 좁히면 관련 없는 쪽이 줄지만 0.03 이하에서는 정답을 놓치기 시작했습니다.
SEARCH_SCORE_MARGIN=0.05
# 낱말 포함 재순위: 질문 낱말이 본문에 실제로 들어 있는 비율 × 이 값을 벡터 점수에 더합니다 (0 이면 끔).
# 한 단어 검색에서 그 단어가 없는 쪽이 위로 올라오는 것을 막습니다. 0.08~0.15 에서 결과가 비슷했습니다.
SEARCH_TERM_WEIGHT=0.10

# ---- LM Studio (로컬 모델). AI PC로 옮기면 그 PC의 주소로 바꿉니다.
LM_STUDIO_URL=http://127.0.0.1:1234/v1
CHAT_MODEL=deepseek-r1-distill-qwen-14b
EMBEDDING_MODEL=text-embedding-qwen3-embedding-4b
# 인덱스 매핑과 같아야 합니다. 바꾸면 기존 색인을 모두 다시 만들어야 합니다.
EMBEDDING_DIMS=2560

# ---- 공개 시작 페이지가 /api/status 를 읽을 수 있는 출처 (쉼표로 여러 개)
STATUS_ALLOWED_ORIGINS=https://yuul-jung.github.io

# ---- 채팅 모델 제공자: local(LM Studio) · openai · anthropic
# 키와 모델을 모두 넣은 제공자만 채팅 화면에 "사용 가능"으로 나타납니다.
LLM_PROVIDERS=local,openai,anthropic
DEFAULT_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=
# OpenAI 호환 서비스를 쓸 때만 주소를 넣습니다 (비우면 OpenAI 기본 주소).
OPENAI_BASE_URL=
# anthropic 은 추가 설치가 필요합니다: .venv/bin/python -m pip install langchain-anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# 업로드 문서 내용(RAG 근거)을 외부 API로 보내도 되는지. 사내·과제 자료가 있으면 false 유지.
ALLOW_EXTERNAL_RAG=false
